{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/display/**",
              "components/domain/**",
              "components/feedback/**",
              "components/figma-reference/**",
              "components/navigation/**",
              "components/primitives/**",
              "ui_kits/grepthink/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Poppins|Fira Code))/i]",
        "message": "Font not provided by the design system. Available: Poppins, Fira Code."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|children|onDismiss|className|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: tone, title, children, onDismiss, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|warning|error|info)$/]",
        "message": "<Alert> tone must be one of 'success' | 'warning' | 'error' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Arrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|direction|variant|key|ref|className|style|children)$/]",
        "message": "<Arrow> doesn't accept that prop. Declared props: className, style, direction, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='Arrow'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:up|down|left|right)$/]",
        "message": "<Arrow> direction must be one of 'up' | 'down' | 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Arrow'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:pixelised|antialias)$/]",
        "message": "<Arrow> variant must be one of 'pixelised' | 'antialias'."
      },
