# GrepThink 2.0 — environment template.
#
# Copy to `.env` at the REPO ROOT (`cp .env.example .env`). Both halves read only
# that one file: backend/app/config.py resolves <repo root>/.env, and
# frontend/vite.config.ts sets envDir to the repo root. frontend/.env and
# backend/.env are ignored.
#
# Only names starting with VITE_ are exposed to the browser bundle. Never put a
# service-role key or JWT secret behind a VITE_ name.

# ---------------------------------------------------------------- backend ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<anon key>                     # anon key: JWKS `apikey` header + RLS-bound fallback client
SUPABASE_SERVICE_ROLE_KEY=<service role key> # bypasses RLS; all authorization is enforced in Python
SUPABASE_JWT_SECRET=<jwt secret>            # verifies HS256 access tokens
SUPABASE_JWK_JSON=                          # optional: project JWK (JSON) for ES256/RS256 tokens

HOST=0.0.0.0
PORT=5001
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # comma-separated; `*` is rejected
FRONTEND_URL=http://localhost:5173          # absolute URL used in transactional emails

# SMTP (invite / .edu verification / contact emails). Leave blank to disable sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Maileroo HTTP API (optional). Set a sending key to send through the API instead of SMTP.
MAILEROO_API_KEY=
MAILEROO_API_URL=                           # default https://smtp.maileroo.com/api/v2
EMAIL_FROM=                                 # "GrepThink <noreply@…>"; falls back to SMTP_FROM

# Email outbox (DEPLOY.md > Email delivery). Locally leave EMAIL_DISPATCH_SECRET blank and set
# EMAIL_DISPATCH_IN_PROCESS=1 only if you want queued emails sent while you test — the dev database
# is shared, so a local dispatcher works through everyone's queue.
EMAIL_DISPATCH_SECRET=
EMAIL_DISPATCH_IN_PROCESS=                  # 1 to dispatch locally (default: only on Vercel production)
EMAIL_DISPATCH_POLL_SECONDS=5
EMAIL_DISPATCH_BUDGET_SECONDS=8             # how long one dispatch run keeps starting sends
EMAIL_INLINE_BUDGET_SECONDS=8               # how long an invite request sends its own emails
MAILEROO_WEBHOOK_SECRET=                    # Maileroo webhook secret (bounces, complaints)
EMAIL_UNSUBSCRIBE_SECRET=                   # signs unsubscribe links; blank = derived from SUPABASE_JWT_SECRET
PUBLIC_API_URL=                             # this API's public URL, for one-click unsubscribe headers

# Analytics (DEPLOY.md). Comma-separated e-mail addresses that may open every institution's dashboard;
# instructors see their own institutions without being listed. Blank = no maintainers.
ANALYTICS_ADMIN_EMAILS=

# Scrum board pull-request chips (optional). A team's own repository token, saved in the board's
# settings, is tried first; these are the fallbacks. Blank = anonymous requests.
GITHUB_TOKEN=                               # fine-grained, read-only on public repos; lifts the 60/h anonymous limit
GITLAB_UCSC_TOKEN=                          # git.ucsc.edu token with read_api; teams usually add their own instead

# AI drafting on the scrum board (optional). Blank AI_API_KEY = off.
AI_BASE_URL=                                # OpenAI-compatible endpoint, e.g. Cloudflare Workers AI
AI_API_KEY=
AI_MODEL=                                   # default @cf/meta/llama-3.1-8b-instruct

# Logging (optional): LOG_LEVEL, LOG_DIR, LOG_CONSOLE_LEVEL, LOG_FILE_LEVEL

# Error reporting to Sentry (optional). Blank = off, which is right for local dev;
# the test suite forces it off. See DEPLOY.md > Error tracking.
SENTRY_DSN=

# --------------------------------------------------------------- frontend ----
VITE_SUPABASE_URL=https://<project-ref>.supabase.co   # same project as SUPABASE_URL
VITE_SUPABASE_ANON_KEY=<anon key>                     # public; ships in the bundle
VITE_API_URL=                                         # production only: backend origin; dev uses the Vite proxy
