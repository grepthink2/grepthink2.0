{
  "name": "frontend",
  "private": true,
  "version": "0.96.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:dev": "vite",
    "dev:prod": "vite --mode prod",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "lint:design": "node scripts/design-adherence.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "design:build": "node scripts/design-system/build.mjs",
    "design:test": "vitest run --config vitest.design.config.ts",
    "design:check": "node scripts/design-system/check.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-gradient-animation": "^1.0.14",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.1",
    "oxlint": "1.93.0",
    "react-dom18": "npm:react-dom@18.3.1",
    "react18": "npm:react@18.3.1",
    "sass": "^1.108.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "react-dom18": {
      "react": "$react"
    }
  }
}
